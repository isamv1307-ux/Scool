<Window x:Class="SchoolEquipmentApp.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Авторизация" Width="520" Height="620" WindowStartupLocation="CenterScreen">
<Grid Margin="20"><Border Background="White" CornerRadius="16" Padding="24"><StackPanel>
<TextBlock Text="🎓" FontSize="60" HorizontalAlignment="Center"/>
<TextBlock Text="МБОУ СОШ № 6 им. Сирина Н.И." FontWeight="Bold" FontSize="24" HorizontalAlignment="Center"/>
<TextBlock Text="Информационная система учета организационной техники" TextAlignment="Center" Margin="0,6,0,20"/>
<TextBlock Text="Логин"/><TextBox x:Name="LoginBox"/>
<TextBlock Text="Пароль"/><PasswordBox x:Name="PasswordBox" Margin="0,0,0,12" Padding="8"/>
<Button Content="Войти" Click="Login_Click" Height="40"/>
<TextBlock Text="Введите логин и пароль для входа в систему" HorizontalAlignment="Center" Margin="0,12,0,0"/>
</StackPanel></Border></Grid></Window>
