<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PrimaryColor">#1F3A5F</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <Style TargetType="Window"><Setter Property="Background" Value="#F4F7FB"/></Style>
    <Style TargetType="Button">
        <Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,6"/>
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="8"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Margin" Value="0,10,0,0"/><Setter Property="AutoGenerateColumns" Value="True"/></Style>
</ResourceDictionary>
